# === 通义千问 (DashScope) 配置 ===
# 免费申请：https://bailian.console.aliyun.com/
# 开通 DashScope「百炼服务」后，在 API-KEY 页面创建你的 Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型选择（留空默认 qwen-turbo）
# qwen-turbo  ：最快、最便宜（0.008元/千tokens）
# qwen-plus   ：综合能力更强（0.032元/千tokens）
# qwen-max    ：最强推理（0.12元/千tokens）
QWEN_MODEL=qwen-turbo
