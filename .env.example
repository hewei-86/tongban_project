# === 通义千问 (DashScope) 配置 ===
# 免费申请：https://bailian.console.aliyun.com/
# 开通 DashScope「百炼服务」后，在 API-KEY 页面创建你的 Key
# 不填也能运行：AI 接口会返回明确标注的演示回复
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型选择（留空默认 qwen-turbo）
# qwen-turbo  ：最快、最便宜（0.008元/千tokens）
# qwen-plus   ：综合能力更强（0.032元/千tokens）
# qwen-max    ：最强推理（0.12元/千tokens）
QWEN_MODEL=qwen-turbo

# === 数据库 ===
# 本地开发默认 SQLite；服务器使用 docker-compose 里的 MySQL。
# 手动连 MySQL 时：
# DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/tongban?charset=utf8mb4
DATABASE_URL=sqlite:///./tongban.db

# === MySQL（docker compose 使用；部署工作流会自动生成，不要提交真实密码）===
MYSQL_DATABASE=tongban
MYSQL_USER=tongban
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# === 登录会话 ===
# 至少 32 位随机字符串；生产环境必须修改，部署工作流会自动生成
JWT_SECRET=change-me-to-a-long-random-string
# TOKEN_DAYS=30

# === 镜像构建 ===
# 国内服务器建议使用阿里云 PyPI 镜像；海外可改回 https://pypi.org/simple
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# === 跨域 ===
# 前后端同域部署（Nginx 反代）时保持 * 即可；
# 前后端分离时建议写成逗号分隔的白名单，例如：
# ALLOW_ORIGINS=https://example.com,https://www.example.com
ALLOW_ORIGINS=*

